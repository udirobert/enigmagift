{
  "name": "enigmagift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:room": "VITE_API_URL= vite build dog-gift-tabletop --outDir dist && wrangler types dog-gift-tabletop/worker-configuration.d.ts --config dog-gift-tabletop/wrangler.jsonc",
    "verify:room": "node scripts/verify-room.mjs",
    "smoke:scenes": "esbuild scripts/smoke-scenes.tsx --bundle --platform=node --format=esm --jsx=automatic --define:import.meta.env={} --external:react --external:react-dom --outfile=node_modules/.cache/smoke-scenes.mjs --log-level=warning && node node_modules/.cache/smoke-scenes.mjs",
    "deploy:room": "npm run build:room && npm run verify:room && wrangler deploy --config dog-gift-tabletop/wrangler.jsonc",
    "test:unit": "esbuild tests/shelfGift.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/shelfGift.test.mjs --log-level=warning && node node_modules/.cache/shelfGift.test.mjs",
    "test": "npm run test:unit && npm run smoke:scenes",
    "build:pages": "VITE_STRIPE_LINK_TRAIL=https://buy.stripe.com/cNi6oIgAj4mSa63acb8EM02 VITE_STRIPE_LINK_HIDE=https://buy.stripe.com/6oU9AUesb1aGcebckj8EM03 VITE_STRIPE_LINK_SET=https://buy.stripe.com/7sYfZiabV6v0emj0BB8EM04 npm run build",
    "verify:pages-build": "node scripts/verify-pages-build.mjs",
    "verify:api-docs": "node scripts/verify-api-docs.mjs",
    "deploy:pages": "npm run build:pages && npm run verify:pages-build && wrangler pages deploy dist --project-name enigmagift --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "@types/three": "^0.187.0",
    "gsap": "^3.12.7",
    "lenis": "^1.1.18",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "4.166.0"
  }
}
